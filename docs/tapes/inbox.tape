# Showcase recording for docs. Regenerate from the repo root with:
#   vhs docs/tapes/inbox.tape
# Requires vhs, ttyd, and ffmpeg on PATH.

Output docs/public/inbox.gif

Set Shell "bash"
Set FontSize 15
Set Width 720
Set Height 380
Set Padding 14
Set TypingSpeed 100ms

Hide
Type "clear && bun examples/inbox.tsx"
Enter
Sleep 3s
Show

Sleep 1.2s
Type "jjjjjjjjjjjjjj"
Sleep 900ms
Type "G"
Sleep 1.4s
Type "g"
Sleep 1.4s
Type "jjjjj"
Sleep 1.2s

Hide
Type "q"
